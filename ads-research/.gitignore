
# Captured ad creatives are third-party material — keep them out of the repo.
# Foreplay pulls: third-party ad data + creatives, large and not ours to redistribute
# per-pull page dumps and snapshots
targets/*/ads.csv
targets/*/ads.json
targets/*/all_transcripts.md
targets/*/analysis.md
targets/*/creatives/
# ...except the ad source we author ourselves. The rule above was written for captured
# competitor media (see targets/audreyyadamsfit/creatives/); our own HTML/CSS is not that.
# Generated renders (out/), the client's photos (img/) and the embedded webfonts (fonts/)
# stay out — they are build output and third-party material.
!targets/home-services-restoration/creatives/
targets/home-services-restoration/creatives/*
!targets/home-services-restoration/creatives/*.html
!targets/home-services-restoration/creatives/*.css
!targets/home-services-restoration/creatives/*.inc
targets/*/pages/
targets/*/pages_*/
targets/*/raw.json
targets/*/report.html
targets/*/shot_*.png
targets/*/shots/
targets/*/snapshots/
targets/*/thumbs/
targets/*/thumbs_small/
targets/*/transcripts/
targets/*/transcripts_index.csv
